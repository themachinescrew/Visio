<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VISIO — Audio Visualizer</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Bebas+Neue&display=swap');

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
–accent: #00ffaa;
–accent2: #ff2d78;
–bg: #050508;
–panel-bg: rgba(10,10,18,0.92);
–text: #e0e0f0;
–dim: #555580;
}

body {
background: var(–bg);
color: var(–text);
font-family: ‘Space Mono’, monospace;
overflow: hidden;
height: 100vh;
width: 100vw;
cursor: none;
}

body.cursor-visible { cursor: default; }

#canvas {
position: fixed;
inset: 0;
width: 100%;
height: 100%;
display: block;
}

/* HUD */
#hud {
position: fixed;
top: 0; left: 0; right: 0;
padding: 18px 28px;
display: flex;
align-items: center;
justify-content: space-between;
z-index: 10;
pointer-events: none;
transition: opacity 0.4s;
}

#hud.hidden { opacity: 0; }

.logo {
font-family: ‘Bebas Neue’, sans-serif;
font-size: 2rem;
letter-spacing: 0.15em;
color: var(–accent);
text-shadow: 0 0 20px var(–accent);
}

.hud-right {
display: flex;
gap: 10px;
pointer-events: all;
}

button {
font-family: ‘Space Mono’, monospace;
font-size: 0.65rem;
letter-spacing: 0.1em;
text-transform: uppercase;
padding: 7px 14px;
border: 1px solid var(–dim);
background: var(–panel-bg);
color: var(–text);
cursor: pointer;
transition: all 0.2s;
}

button:hover, button.active {
border-color: var(–accent);
color: var(–accent);
box-shadow: 0 0 10px rgba(0,255,170,0.3);
}

/* Start screen */
#start-screen {
position: fixed;
inset: 0;
background: var(–bg);
display: flex;
flex-direction: column;
align-items: center;
justify-content: center;
z-index: 100;
gap: 16px;
}

#start-screen h1 {
font-family: ‘Bebas Neue’, sans-serif;
font-size: clamp(4rem, 12vw, 9rem);
letter-spacing: 0.2em;
color: var(–accent);
text-shadow: 0 0 60px rgba(0,255,170,0.5), 0 0 120px rgba(0,255,170,0.2);
animation: pulse 3s ease-in-out infinite;
}

@keyframes pulse {
0%, 100% { text-shadow: 0 0 40px rgba(0,255,170,0.4), 0 0 100px rgba(0,255,170,0.1); }
50% { text-shadow: 0 0 80px rgba(0,255,170,0.7), 0 0 160px rgba(0,255,170,0.3); }
}

#start-screen p {
font-size: 0.75rem;
color: var(–dim);
letter-spacing: 0.12em;
max-width: 380px;
text-align: center;
line-height: 1.8;
margin-bottom: 8px;
}

#start-btn {
font-size: 0.8rem;
padding: 14px 36px;
border-color: var(–accent);
color: var(–accent);
background: transparent;
position: relative;
overflow: hidden;
}

#start-btn::after {
content: ‘’;
position: absolute;
inset: 0;
background: var(–accent);
opacity: 0;
transition: opacity 0.2s;
}

#start-btn:hover::after { opacity: 0.08; }

.source-btns {
display: flex;
gap: 8px;
margin-bottom: 4px;
}

.source-btn {
font-size: 0.7rem;
padding: 10px 20px;
}

.source-btn.selected {
border-color: var(–accent2);
color: var(–accent2);
box-shadow: 0 0 10px rgba(255,45,120,0.3);
}

/* Side panel */
#panel {
position: fixed;
right: 0;
top: 0;
bottom: 0;
width: 260px;
background: var(–panel-bg);
border-left: 1px solid rgba(255,255,255,0.06);
padding: 80px 20px 20px;
z-index: 9;
transform: translateX(100%);
transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
overflow-y: auto;
backdrop-filter: blur(20px);
}

#panel.open { transform: translateX(0); }

.panel-section {
margin-bottom: 28px;
}

.panel-label {
font-size: 0.6rem;
color: var(–dim);
letter-spacing: 0.18em;
text-transform: uppercase;
margin-bottom: 10px;
display: block;
}

.mode-grid {
display: grid;
grid-template-columns: 1fr 1fr;
gap: 6px;
}

.mode-btn {
font-size: 0.58rem;
padding: 8px 4px;
text-align: center;
}

.mode-btn.active {
border-color: var(–accent);
color: var(–accent);
background: rgba(0,255,170,0.06);
}

.color-grid {
display: grid;
grid-template-columns: repeat(4, 1fr);
gap: 6px;
}

.color-swatch {
width: 100%;
aspect-ratio: 1;
border: 2px solid transparent;
cursor: pointer;
transition: transform 0.15s, border-color 0.15s;
}

.color-swatch:hover { transform: scale(1.12); }
.color-swatch.active { border-color: white; }

.slider-row {
display: flex;
flex-direction: column;
gap: 10px;
}

.slider-item {
display: flex;
flex-direction: column;
gap: 5px;
}

.slider-item span {
font-size: 0.6rem;
color: var(–dim);
letter-spacing: 0.1em;
display: flex;
justify-content: space-between;
}

input[type=range] {
-webkit-appearance: none;
width: 100%;
height: 2px;
background: var(–dim);
outline: none;
}

input[type=range]::-webkit-slider-thumb {
-webkit-appearance: none;
width: 12px;
height: 12px;
background: var(–accent);
border-radius: 50%;
cursor: pointer;
box-shadow: 0 0 8px var(–accent);
}

/* Mode label overlay */
#mode-label {
position: fixed;
bottom: 30px;
left: 50%;
transform: translateX(-50%);
font-family: ‘Bebas Neue’, sans-serif;
font-size: 0.9rem;
letter-spacing: 0.3em;
color: rgba(255,255,255,0.15);
z-index: 5;
pointer-events: none;
transition: opacity 0.4s;
}

#mode-label.hidden { opacity: 0; }

/* Freq display */
#freq-display {
position: fixed;
bottom: 28px;
right: 28px;
font-size: 0.55rem;
color: rgba(255,255,255,0.12);
letter-spacing: 0.1em;
pointer-events: none;
z-index: 5;
transition: opacity 0.4s;
}

#freq-display.hidden { opacity: 0; }
</style>

</head>
<body>

<canvas id="canvas"></canvas>

<!-- Start Screen -->

<div id="start-screen">
  <h1>VISIO</h1>
  <p>A fullscreen audio visualizer. Choose your audio source, then press activate.</p>
  <div class="source-btns">
    <button class="source-btn selected" id="src-mic">🎙 Microphone</button>
    <button class="source-btn" id="src-tab">🎵 Browser Tab</button>
  </div>
  <p style="font-size:0.6rem; max-width:320px;">
    For Spotify desktop app, use microphone mode with a loopback device (e.g. BlackHole on Mac, VB-Cable on Windows).
    For Spotify Web Player, use Browser Tab mode.
  </p>
  <button id="start-btn">▶ Activate Visualizer</button>
</div>

<!-- HUD -->

<div id="hud">
  <div class="logo">VISIO</div>
  <div class="hud-right">
    <button id="fs-btn">⛶ Fullscreen</button>
    <button id="panel-toggle">⚙ Customize</button>
  </div>
</div>

<!-- Side Panel -->

<div id="panel">
  <span class="panel-label">Visualization Mode</span>
  <div class="panel-section">
    <div class="mode-grid">
      <button class="mode-btn active" data-mode="bars">Bars</button>
      <button class="mode-btn" data-mode="wave">Wave</button>
      <button class="mode-btn" data-mode="radial">Radial</button>
      <button class="mode-btn" data-mode="particles">Particles</button>
      <button class="mode-btn" data-mode="scope">Oscilloscope</button>
      <button class="mode-btn" data-mode="mirror">Mirror</button>
    </div>
  </div>

  <div class="panel-section">
    <span class="panel-label">Color Palette</span>
    <div class="color-grid">
      <div class="color-swatch active" data-palette="cyber" style="background: linear-gradient(135deg,#00ffaa,#0088ff)"></div>
      <div class="color-swatch" data-palette="fire" style="background: linear-gradient(135deg,#ff6b00,#ff2d78)"></div>
      <div class="color-swatch" data-palette="violet" style="background: linear-gradient(135deg,#a855f7,#ec4899)"></div>
      <div class="color-swatch" data-palette="ice" style="background: linear-gradient(135deg,#67e8f9,#818cf8)"></div>
      <div class="color-swatch" data-palette="gold" style="background: linear-gradient(135deg,#fbbf24,#f97316)"></div>
      <div class="color-swatch" data-palette="mono" style="background: linear-gradient(135deg,#e0e0e0,#606060)"></div>
      <div class="color-swatch" data-palette="lime" style="background: linear-gradient(135deg,#84cc16,#22c55e)"></div>
      <div class="color-swatch" data-palette="blood" style="background: linear-gradient(135deg,#ef4444,#7c3aed)"></div>
    </div>
  </div>

  <div class="panel-section">
    <span class="panel-label">Settings</span>
    <div class="slider-row">
      <div class="slider-item">
        <span><label>Sensitivity</label><span id="sens-val">80</span></span>
        <input type="range" id="sensitivity" min="10" max="200" value="80">
      </div>
      <div class="slider-item">
        <span><label>Smoothing</label><span id="smooth-val">0.8</span></span>
        <input type="range" id="smoothing" min="0" max="95" value="80">
      </div>
      <div class="slider-item">
        <span><label>Glow</label><span id="glow-val">60</span></span>
        <input type="range" id="glow" min="0" max="100" value="60">
      </div>
      <div class="slider-item">
        <span><label>Decay</label><span id="decay-val">0.05</span></span>
        <input type="range" id="decay" min="1" max="20" value="5">
      </div>
    </div>
  </div>
</div>

<div id="mode-label">BARS</div>
<div id="freq-display">-- Hz / -- dB</div>

<script>
const canvas = document.getElementById('canvas');
const ctx = canvas.getContext('2d');

let analyser, dataArray, bufferLength;
let animId;
let mode = 'bars';
let palette = 'cyber';
let sensitivity = 80;
let smoothingVal = 0.8;
let glowAmount = 60;
let decayVal = 0.05;
let sourceType = 'mic';
let hudTimeout;
let particles = [];
let peakHold = [];

const palettes = {
  cyber:  ['#00ffaa','#00ccff','#0044ff'],
  fire:   ['#ff6b00','#ff2d78','#ffcc00'],
  violet: ['#a855f7','#ec4899','#8b5cf6'],
  ice:    ['#67e8f9','#818cf8','#a5f3fc'],
  gold:   ['#fbbf24','#f97316','#fef08a'],
  mono:   ['#ffffff','#aaaaaa','#555555'],
  lime:   ['#84cc16','#22c55e','#4ade80'],
  blood:  ['#ef4444','#7c3aed','#f97316'],
};

function getColor(t) {
  const p = palettes[palette];
  const n = p.length - 1;
  const i = Math.floor(t * n);
  const f = t * n - i;
  const c1 = hexToRgb(p[Math.min(i, n)]);
  const c2 = hexToRgb(p[Math.min(i+1, n)]);
  const r = Math.round(c1.r + (c2.r - c1.r) * f);
  const g = Math.round(c1.g + (c2.g - c1.g) * f);
  const b = Math.round(c1.b + (c2.b - c1.b) * f);
  return `rgb(${r},${g},${b})`;
}

function hexToRgb(hex) {
  const r = parseInt(hex.slice(1,3),16);
  const g = parseInt(hex.slice(3,5),16);
  const b = parseInt(hex.slice(5,7),16);
  return {r,g,b};
}

function getColorAlpha(t, a) {
  const p = palettes[palette];
  const n = p.length - 1;
  const i = Math.floor(t * n);
  const f = t * n - i;
  const c1 = hexToRgb(p[Math.min(i, n)]);
  const c2 = hexToRgb(p[Math.min(i+1, n)]);
  const r = Math.round(c1.r + (c2.r - c1.r) * f);
  const g = Math.round(c1.g + (c2.g - c1.g) * f);
  const b = Math.round(c1.b + (c2.b - c1.b) * f);
  return `rgba(${r},${g},${b},${a})`;
}

function resize() {
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
  initParticles();
}

window.addEventListener('resize', resize);
resize();

function initParticles() {
  particles = [];
  for (let i = 0; i < 120; i++) {
    particles.push({
      x: Math.random() * canvas.width,
      y: Math.random() * canvas.height,
      vx: (Math.random() - 0.5) * 0.5,
      vy: (Math.random() - 0.5) * 0.5,
      size: Math.random() * 2 + 0.5,
      t: Math.random(),
      energy: 0,
    });
  }
}

// --- Drawing Modes ---

function drawBars() {
  const W = canvas.width, H = canvas.height;
  const count = Math.min(bufferLength, 128);
  const barW = W / count;
  const glow = glowAmount / 100;

  ctx.clearRect(0, 0, W, H);

  // Background glow
  for (let i = 0; i < count; i++) {
    const val = dataArray[i] / 255 * (sensitivity / 80);
    const barH = val * H * 0.8;
    const x = i * barW;
    const t = i / count;
    ctx.shadowBlur = 24 * glow;
    ctx.shadowColor = getColor(t);
    ctx.fillStyle = getColorAlpha(t, 0.15);
    ctx.fillRect(x, H - barH, barW - 1, barH);
  }

  ctx.shadowBlur = 0;

  for (let i = 0; i < count; i++) {
    const val = dataArray[i] / 255 * (sensitivity / 80);
    const barH = Math.min(val * H * 0.8, H);
    const x = i * barW;
    const t = i / count;

    // Peak hold
    if (!peakHold[i] || val > peakHold[i]) peakHold[i] = val;
    else peakHold[i] = Math.max(0, peakHold[i] - decayVal);

    // Bar gradient
    const grad = ctx.createLinearGradient(x, H, x, H - barH);
    grad.addColorStop(0, getColorAlpha(t, 0.9));
    grad.addColorStop(1, getColorAlpha(1 - t * 0.3, 0.5));
    ctx.fillStyle = grad;

    ctx.shadowBlur = 18 * glow;
    ctx.shadowColor = getColor(t);
    ctx.fillRect(x, H - barH, barW - 1, barH);

    // Peak line
    const peakH = peakHold[i] * H * 0.8;
    ctx.fillStyle = getColorAlpha(t, 0.8);
    ctx.fillRect(x, H - peakH - 2, barW - 1, 2);
  }
}

function drawWave() {
  const W = canvas.width, H = canvas.height;
  const count = bufferLength;
  const glow = glowAmount / 100;

  ctx.clearRect(0, 0, W, H);

  // Multiple wave layers
  for (let layer = 0; layer < 3; layer++) {
    const offset = layer * Math.floor(count / 3);
    ctx.beginPath();
    const alpha = [0.8, 0.4, 0.2][layer];
    const thick = [2.5, 1.5, 1][layer];

    for (let i = 0; i < count; i++) {
      const val = (dataArray[(i + offset) % count] / 128 - 1) * (sensitivity / 80);
      const x = (i / count) * W;
      const y = H / 2 + val * H * 0.35;
      i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
    }

    ctx.strokeStyle = getColorAlpha(layer / 2, alpha);
    ctx.lineWidth = thick;
    ctx.shadowBlur = 30 * glow;
    ctx.shadowColor = getColor(layer / 2);
    ctx.stroke();
  }
}

function drawRadial() {
  const W = canvas.width, H = canvas.height;
  const cx = W / 2, cy = H / 2;
  const count = Math.min(bufferLength, 256);
  const glow = glowAmount / 100;
  const baseR = Math.min(W, H) * 0.18;

  ctx.clearRect(0, 0, W, H);

  // Inner glow circle
  const radGrad = ctx.createRadialGradient(cx, cy, 0, cx, cy, baseR * 1.5);
  radGrad.addColorStop(0, getColorAlpha(0, 0.12 * glow));
  radGrad.addColorStop(1, 'transparent');
  ctx.fillStyle = radGrad;
  ctx.fillRect(0, 0, W, H);

  // Radial bars
  for (let i = 0; i < count; i++) {
    const val = dataArray[i] / 255 * (sensitivity / 80);
    const angle = (i / count) * Math.PI * 2 - Math.PI / 2;
    const len = val * baseR * 2.2;
    const t = i / count;

    const x1 = cx + Math.cos(angle) * baseR;
    const y1 = cy + Math.sin(angle) * baseR;
    const x2 = cx + Math.cos(angle) * (baseR + len);
    const y2 = cy + Math.sin(angle) * (baseR + len);

    ctx.beginPath();
    ctx.moveTo(x1, y1);
    ctx.lineTo(x2, y2);
    ctx.strokeStyle = getColorAlpha(t, 0.9);
    ctx.lineWidth = 2;
    ctx.shadowBlur = 16 * glow;
    ctx.shadowColor = getColor(t);
    ctx.stroke();
  }

  // Center circle
  ctx.beginPath();
  ctx.arc(cx, cy, baseR - 2, 0, Math.PI * 2);
  ctx.strokeStyle = getColorAlpha(0.5, 0.3);
  ctx.lineWidth = 1;
  ctx.shadowBlur = 0;
  ctx.stroke();
}

function drawParticles() {
  const W = canvas.width, H = canvas.height;
  const glow = glowAmount / 100;

  // Trail effect
  ctx.fillStyle = 'rgba(5,5,8,0.15)';
  ctx.fillRect(0, 0, W, H);

  // Get average energy bands
  const bass = getAvg(0, 8) / 255 * (sensitivity / 80);
  const mid = getAvg(8, 64) / 255 * (sensitivity / 80);
  const high = getAvg(64, 128) / 255 * (sensitivity / 80);

  for (let p of particles) {
    // Energy based on position in frequency
    p.energy = p.t < 0.33 ? bass : p.t < 0.66 ? mid : high;
    const speed = 1 + p.energy * 6;
    p.x += p.vx * speed;
    p.y += p.vy * speed;

    // Bounce
    if (p.x < 0 || p.x > W) p.vx *= -1;
    if (p.y < 0 || p.y > H) p.vy *= -1;

    const size = p.size + p.energy * 4;
    ctx.beginPath();
    ctx.arc(p.x, p.y, size, 0, Math.PI * 2);
    ctx.fillStyle = getColorAlpha(p.t, 0.8);
    ctx.shadowBlur = 20 * glow * p.energy;
    ctx.shadowColor = getColor(p.t);
    ctx.fill();
  }

  // Central energy ring
  const cx = W/2, cy = H/2;
  const r = 80 + bass * 150;
  ctx.beginPath();
  ctx.arc(cx, cy, r, 0, Math.PI * 2);
  ctx.strokeStyle = getColorAlpha(0.5, 0.4 * bass);
  ctx.lineWidth = 2 + bass * 4;
  ctx.shadowBlur = 40 * glow;
  ctx.shadowColor = getColor(0);
  ctx.stroke();
}

function drawScope() {
  const W = canvas.width, H = canvas.height;
  const glow = glowAmount / 100;

  ctx.clearRect(0, 0, W, H);

  // Grid
  ctx.strokeStyle = 'rgba(255,255,255,0.04)';
  ctx.lineWidth = 1;
  ctx.shadowBlur = 0;
  for (let i = 1; i < 8; i++) {
    ctx.beginPath(); ctx.moveTo(W * i/8, 0); ctx.lineTo(W * i/8, H); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(0, H * i/8); ctx.lineTo(W, H * i/8); ctx.stroke();
  }

  // Oscilloscope wave
  ctx.beginPath();
  for (let i = 0; i < bufferLength; i++) {
    const val = (dataArray[i] / 128 - 1) * (sensitivity / 80);
    const x = (i / bufferLength) * W;
    const y = H / 2 + val * H * 0.4;
    i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
  }
  ctx.strokeStyle = getColorAlpha(0.3, 0.9);
  ctx.lineWidth = 2;
  ctx.shadowBlur = 20 * glow;
  ctx.shadowColor = getColor(0.3);
  ctx.stroke();
}

function drawMirror() {
  const W = canvas.width, H = canvas.height;
  const count = Math.min(bufferLength, 128);
  const glow = glowAmount / 100;

  ctx.clearRect(0, 0, W, H);

  const barW = (W / 2) / count;

  for (let i = 0; i < count; i++) {
    const val = dataArray[i] / 255 * (sensitivity / 80);
    const barH = Math.min(val * H * 0.9, H);
    const t = i / count;

    const xRight = W / 2 + i * barW;
    const xLeft = W / 2 - (i + 1) * barW;

    const grad = ctx.createLinearGradient(0, H/2 - barH/2, 0, H/2 + barH/2);
    grad.addColorStop(0, getColorAlpha(t, 0.6));
    grad.addColorStop(0.5, getColorAlpha(1 - t, 0.95));
    grad.addColorStop(1, getColorAlpha(t, 0.6));

    ctx.fillStyle = grad;
    ctx.shadowBlur = 14 * glow;
    ctx.shadowColor = getColor(t);

    ctx.fillRect(xRight, H/2 - barH/2, barW - 1, barH);
    ctx.fillRect(xLeft, H/2 - barH/2, barW - 1, barH);
  }
}

function getAvg(start, end) {
  let sum = 0;
  for (let i = start; i < end && i < bufferLength; i++) sum += dataArray[i];
  return sum / (end - start);
}

function draw() {
  if (!analyser) return;
  analyser.getByteFrequencyData(dataArray);

  ctx.shadowBlur = 0;

  switch(mode) {
    case 'bars': drawBars(); break;
    case 'wave': drawWave(); break;
    case 'radial': drawRadial(); break;
    case 'particles': drawParticles(); break;
    case 'scope': drawScope(); break;
    case 'mirror': drawMirror(); break;
  }

  // Freq info
  const peak = dataArray.indexOf(Math.max(...dataArray));
  const sampleRate = analyser.context.sampleRate;
  const hz = Math.round(peak * sampleRate / (analyser.fftSize));
  const db = Math.round(20 * Math.log10(dataArray[peak] / 255));
  document.getElementById('freq-display').textContent = `${hz} Hz / ${db} dB`;

  animId = requestAnimationFrame(draw);
}

// --- Setup Audio ---

async function startAudio() {
  try {
    let stream;
    if (sourceType === 'mic') {
      stream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
    } else {
      stream = await navigator.mediaDevices.getDisplayMedia({ audio: true, video: true });
    }

    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    const source = audioCtx.createMediaStreamSource(stream);
    analyser = audioCtx.createAnalyser();
    analyser.fftSize = 2048;
    analyser.smoothingTimeConstant = smoothingVal;
    source.connect(analyser);
    bufferLength = analyser.frequencyBinCount;
    dataArray = new Uint8Array(bufferLength);
    peakHold = new Array(bufferLength).fill(0);

    document.getElementById('start-screen').style.display = 'none';
    draw();
  } catch(e) {
    alert('Could not access audio: ' + e.message + '\n\nMake sure to allow audio permissions.');
  }
}

// --- Controls ---

document.getElementById('start-btn').addEventListener('click', startAudio);

document.getElementById('src-mic').addEventListener('click', () => {
  sourceType = 'mic';
  document.querySelectorAll('.source-btn').forEach(b => b.classList.remove('selected'));
  document.getElementById('src-mic').classList.add('selected');
});

document.getElementById('src-tab').addEventListener('click', () => {
  sourceType = 'tab';
  document.querySelectorAll('.source-btn').forEach(b => b.classList.remove('selected'));
  document.getElementById('src-tab').classList.add('selected');
});

document.getElementById('fs-btn').addEventListener('click', () => {
  if (!document.fullscreenElement) document.documentElement.requestFullscreen();
  else document.exitFullscreen();
});

const panelEl = document.getElementById('panel');
document.getElementById('panel-toggle').addEventListener('click', () => {
  panelEl.classList.toggle('open');
});

document.querySelectorAll('.mode-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.mode-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    mode = btn.dataset.mode;
    document.getElementById('mode-label').textContent = mode.toUpperCase();
    peakHold = new Array(bufferLength || 1024).fill(0);
  });
});

document.querySelectorAll('.color-swatch').forEach(sw => {
  sw.addEventListener('click', () => {
    document.querySelectorAll('.color-swatch').forEach(s => s.classList.remove('active'));
    sw.classList.add('active');
    palette = sw.dataset.palette;
  });
});

document.getElementById('sensitivity').addEventListener('input', function() {
  sensitivity = +this.value;
  document.getElementById('sens-val').textContent = this.value;
});

document.getElementById('smoothing').addEventListener('input', function() {
  smoothingVal = this.value / 100;
  document.getElementById('smooth-val').textContent = smoothingVal.toFixed(2);
  if (analyser) analyser.smoothingTimeConstant = smoothingVal;
});

document.getElementById('glow').addEventListener('input', function() {
  glowAmount = +this.value;
  document.getElementById('glow-val').textContent = this.value;
});

document.getElementById('decay').addEventListener('input', function() {
  decayVal = this.value / 100;
  document.getElementById('decay-val').textContent = decayVal.toFixed(2);
});

// Auto-hide HUD on mouse idle
let cursorTimer;
document.addEventListener('mousemove', () => {
  document.body.classList.add('cursor-visible');
  document.getElementById('hud').classList.remove('hidden');
  document.getElementById('mode-label').classList.remove('hidden');
  document.getElementById('freq-display').classList.remove('hidden');
  clearTimeout(cursorTimer);
  cursorTimer = setTimeout(() => {
    if (!panelEl.classList.contains('open')) {
      document.body.classList.remove('cursor-visible');
      document.getElementById('hud').classList.add('hidden');
      document.getElementById('mode-label').classList.add('hidden');
      document.getElementById('freq-display').classList.add('hidden');
    }
  }, 3000);
});

// Keyboard shortcuts
document.addEventListener('keydown', e => {
  const modes = ['bars','wave','radial','particles','scope','mirror'];
  if (e.key >= '1' && e.key <= '6') {
    const m = modes[+e.key - 1];
    mode = m;
    document.querySelectorAll('.mode-btn').forEach(b => {
      b.classList.toggle('active', b.dataset.mode === m);
    });
    document.getElementById('mode-label').textContent = m.toUpperCase();
  }
  if (e.key === 'f') {
    if (!document.fullscreenElement) document.documentElement.requestFullscreen();
    else document.exitFullscreen();
  }
  if (e.key === 'c') panelEl.classList.toggle('open');
});
</script>

</body>
